{
  "name": "project-booth",
  "version": "0.0.0",
  "private": true,
  "description": "Project Booth workspace",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "container:build": "docker compose build api",
    "container:down": "docker compose down --remove-orphans",
    "container:health": "node scripts/check-container-datastores.mjs",
    "container:logs": "docker compose logs --follow api worker",
    "container:start": "docker compose up --build --detach --wait",
    "container:status": "docker compose ps --all",
    "container:stop": "docker compose stop --timeout 10",
    "contracts:check": "pnpm --filter @project-booth/contracts run check:compatibility",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
