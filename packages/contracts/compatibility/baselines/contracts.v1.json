            "recipientUserId": {
              "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-8][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$",
              "type": "string"
            }
          },
          "required": ["recipientUserId"],
          "type": "object"
        }
      },
      {
        "if": {
          "properties": {
            "audience": {
              "enum": ["active", "participants"]
            }
          },
          "required": ["audience"],
          "type": "object"
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "#/$defs/sharedSafeValue"
            }
          },
          "type": "object"
        }
      }
