# Host port for the local API.
PHONE_BOOTH_API_PORT=3000

# Host port for PostgreSQL integration tests and migration commands.
PHONE_BOOTH_POSTGRES_PORT=5432

# Development-only container connection URLs used by the API and worker.
DATABASE_URL=postgresql://phone_booth:phone_booth_dev@postgres:5432/phone_booth
VALKEY_URL=redis://valkey:6379

# Identity is opt-in. Development auth is rejected whenever NODE_ENV=production.
IDENTITY_PROVIDER=disabled
APPLE_CLIENT_ID=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ACCOUNT_DELETION_DELAY_SECONDS=0
MATCHMAKING_READY_TIMEOUT_SECONDS=15
MATCH_LOBBY_READY_TIMEOUT_SECONDS=30
MATCHMAKING_RECENT_PAIRING_SECONDS=86400
REALTIME_HEARTBEAT_INTERVAL_MS=10000
REALTIME_HEARTBEAT_TIMEOUT_MS=30000
REALTIME_RESUME_LIMIT=100
